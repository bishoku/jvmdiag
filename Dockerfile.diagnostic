# A full HotSpot JDK is required for attach and binary JFR decoding.
# Build one image per target major; pass digest-pinned refs when publishing.
ARG GO_IMAGE=golang:1.27.3-bookworm
ARG JDK_IMAGE=eclipse-temurin:17-jdk-jammy
FROM ${GO_IMAGE} AS builder
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
WORKDIR /src
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w -buildid= -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" -o /out/jvmdiag ./cmd/jvmdiag

FROM ${JDK_IMAGE}
COPY --from=builder /out/jvmdiag /usr/local/bin/jvmdiag
COPY LICENSE NOTICE LICENSE-Go.txt THIRD_PARTY_NOTICES.md /usr/share/licenses/jvmdiag/
COPY internal/server/assets/js/LICENSE.marked.txt /usr/share/licenses/jvmdiag/LICENSE.marked.txt
ARG VERSION=dev
ARG COMMIT=unknown
ARG SOURCE_URL=""
LABEL org.opencontainers.image.title="go-jvmdiag diagnostic" org.opencontainers.image.version="${VERSION}" org.opencontainers.image.revision="${COMMIT}" org.opencontainers.image.source="${SOURCE_URL}" org.opencontainers.image.licenses="Apache-2.0"
ENV HOME=/tmp
# Numeric identity is overridden by the debug profile to match the target JVM.
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["jvmdiag"]
CMD ["help"]
